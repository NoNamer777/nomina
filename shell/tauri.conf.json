{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Nomina",
    "version": "0.1.0",
    "identifier": "org.eu.nl.oscarwellner.nomina",
    "build": {
        "beforeDevCommand": "pnpm frontend:start",
        "beforeBuildCommand": "pnpm frontend:build",
        "devUrl": "http://localhost:4200",
        "frontendDist": "../dist/nomina/browser"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
    },
    "app": {
        "windows": [
            {
                "title": "Nomina",
                "width": 1200,
                "height": 800
            }
        ],
        "security": {
            "csp": null
        }
    }
}
