{
  "name": "nomina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "frontend:start": "ng serve",
    "frontend:build": "ng build",
    "shell:start": "tauri dev -c shell/tauri.conf.json",
    "shell:build": "tauri build",
    "format:check": "prettier -l .",
    "format:write": "prettier -w ."
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "~24.15"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "~24.15",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "11.1.1",
        "onFail": "error"
      },
      {
        "name": "npm",
        "version": "11.12.1",
        "onFail": "warn"
      }
    ]
  },
  "dependencies": {
    "@angular/common": "~22.1.4",
    "@angular/compiler": "~22.1.4",
    "@angular/core": "~22.1.4",
    "@angular/forms": "~22.1.4",
    "@angular/platform-browser": "~22.1.4",
    "@angular/router": "~22.1.4",
    "@tailwindcss/postcss": "~4.3.3",
    "@tauri-apps/api": "~2.11.1",
    "postcss": "~8.5.26",
    "rxjs": "~7.8.2",
    "tailwindcss": "~4.3.3",
    "tslib": "~2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.1.6",
    "@angular/cli": "~22.1.6",
    "@angular/compiler-cli": "~22.1.4",
    "@tauri-apps/cli": "~2.11.4",
    "prettier": "~3.9.6",
    "prettier-plugin-organize-imports": "~4.3.0",
    "typescript": "~6.0.3"
  }
}
